# ---------------------------------------------------------------------------
# Prode environment variables. Copy this file to `.env` and fill in values.
# Never commit your real .env — it is gitignored.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local docker-compose default (matches docker-compose.yml):
DATABASE_URL=postgres://prode:prode@localhost:5432/prode

# PRODUCTION (Supabase): use the *Session pooler* connection string from
# Supabase → Project → Connect. It is IPv4-compatible (Render can't reach the
# IPv6-only direct host) and works for migrations. Looks like:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# SSL is auto-enabled for supabase hosts, so you don't need DATABASE_SSL.
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Comma-separated list of display names that are granted admin powers
# (enter/edit real results, manage matches/users, edit scoring config).
# Case-insensitive. The first person to sign in with one of these names
# becomes an admin automatically.
ADMIN_NAMES=admin

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Public base URL of the app (used for absolute links / metadata).
# Local: http://localhost:3000 — on Render set to your onrender.com URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
